# Biometric Agent Configuration Example

# Device configurations
DEVICE_NAME=K50-MAIN
DEVICE_IP=192.168.1.201
DEVICE_PORT=4370
DEVICE_TIMEOUT=10

# Laravel ERP API configurations
# For local testing under Laragon, you can use: http://localhost:8000/api/v1/emmanuel
# For production: https://your-erp-domain.com/api/v1/tenant-subdomain
ERP_API_URL=http://localhost:8000/api/v1/emmanuel
ERP_API_TOKEN=test-token-k50

# Synchronization interval (in seconds)
SYNC_INTERVAL=60

# Local SQLite database path
LOCAL_DATABASE=biometric_agent.db

# Logging configurations (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
